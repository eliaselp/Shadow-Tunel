# ================================================================
#  VPN PERSONAL - Credenciales del servidor VPS
#  Copia este archivo a .env y completa los valores.
#  setup-server.sh lee este archivo automaticamente.
# ================================================================

# Usuario SSH (si conectas como root, pon: root)
user=root

# IP del servidor VPS
ip-server=207.180.29.249

# Contrasena SSH del usuario (se usa con sshpass)
password=CAMBIAME

# Opcional: en vez de contrasena puedes usar una clave SSH privada
# ssh-key=/ruta/a/tu/clave_privada
